{
  "$comment": "Contracts for quality-findings.json, quality-ledger.json, and traceability-matrix.json. validate-quality-run.cjs interprets these schemas directly and adds cross-file checks in code. Defect records follow the ISO/IEC/IEEE 29119-3 incident report contents; test cases follow its test case specification; terminology follows the ISTQB glossary (test basis, test condition, test oracle, defect, failure); quality_characteristic uses the ISO/IEC 25010:2023 product quality model.",
  "findings": {
    "type": "array",
    "items": {
      "oneOf": [
        {
          "type": "object",
          "description": "A defect in the application whose failure was demonstrated from source, a sandboxed local run, or an authorized staging check, with a recommended regression test.",
          "properties": {
            "verdict": { "type": "string", "const": "confirmed" },
            "fingerprint": { "$ref": "#fingerprint" },
            "module": { "$ref": "#module" },
            "rule": { "$ref": "#rule" },
            "quality_characteristic": { "$ref": "#characteristic" },
            "title": { "type": "string", "minLength": 1, "visibleContent": true },
            "description": { "type": "string", "minLength": 1, "visibleContent": true },
            "root_cause": { "type": "string", "minLength": 1, "visibleContent": true },
            "oracle": {
              "type": "object",
              "description": "How the expected result is known (ISTQB test oracle).",
              "properties": {
                "kind": { "type": "string", "enum": ["requirement", "contract", "documentation", "code_contract", "consistency", "domain_rule"] },
                "description": { "type": "string", "minLength": 1, "visibleContent": true }
              },
              "required": ["kind", "description"],
              "additionalProperties": false
            },
            "test_basis": {
              "type": "array",
              "items": { "$ref": "#location" },
              "description": "Requirement, specification, contract, or documentation locations the oracle relies on."
            },
            "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#location" } },
            "reproduction": {
              "type": "object",
              "properties": {
                "method": { "$ref": "#method" },
                "environment": { "type": "string", "minLength": 1, "visibleContent": true },
                "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1, "visibleContent": true } },
                "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "visibleContent": true } },
                "input": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "expected_result": { "type": "string", "minLength": 1, "visibleContent": true },
                "actual_result": { "type": "string", "minLength": 1, "visibleContent": true },
                "artifact": { "type": ["string", "null"], "minLength": 1 }
              },
              "required": ["method", "environment", "preconditions", "steps", "input", "expected_result", "actual_result", "artifact"],
              "additionalProperties": false
            },
            "impact": { "type": "string", "minLength": 1, "visibleContent": true },
            "remediation": {
              "type": "object",
              "properties": {
                "strategy": { "type": "string", "minLength": 1, "visibleContent": true },
                "code_changes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": { "type": "string", "minLength": 1 },
                      "description": { "type": "string", "minLength": 1, "visibleContent": true }
                    },
                    "required": ["file", "description"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["strategy"],
              "additionalProperties": false
            },
            "regression_test": {
              "type": "object",
              "properties": {
                "level": { "$ref": "#test_level" },
                "test_case": { "$ref": "#test_case" },
                "script": {
                  "type": "object",
                  "properties": {
                    "framework": { "type": "string", "minLength": 1, "visibleContent": true },
                    "language": { "type": "string", "minLength": 1, "visibleContent": true },
                    "file": { "type": "string", "minLength": 1 },
                    "code": { "type": "string", "minLength": 1, "visibleContent": true }
                  },
                  "required": ["framework", "language", "file", "code"],
                  "additionalProperties": false
                },
                "verified_failing": {
                  "type": "boolean",
                  "description": "True only when the script was run against the current code in the sandbox or staging and failed for the reported reason."
                }
              },
              "required": ["level", "test_case", "script", "verified_failing"],
              "additionalProperties": false
            },
            "severity": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
            "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
          },
          "required": [
            "verdict", "fingerprint", "module", "rule", "quality_characteristic", "title", "description", "root_cause",
            "oracle", "test_basis", "locations", "reproduction", "impact", "remediation", "regression_test", "severity", "confidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A source-grounded defect hypothesis blocked on an exact unresolved fact. It carries no severity.",
          "properties": {
            "verdict": { "type": "string", "const": "needs_validation" },
            "fingerprint": { "$ref": "#fingerprint" },
            "module": { "$ref": "#module" },
            "rule": { "$ref": "#rule" },
            "quality_characteristic": { "$ref": "#characteristic" },
            "title": { "type": "string", "minLength": 1, "visibleContent": true },
            "description": { "type": "string", "minLength": 1, "visibleContent": true },
            "claimed_root_cause": { "type": "string", "minLength": 1, "visibleContent": true },
            "test_basis": { "type": "array", "items": { "$ref": "#location" } },
            "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#location" } },
            "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "visibleContent": true } },
            "validation_plan": { "type": "string", "minLength": 1, "visibleContent": true },
            "proposed_test_case": { "$ref": "#test_case" }
          },
          "required": [
            "verdict", "fingerprint", "module", "rule", "quality_characteristic", "title", "description",
            "claimed_root_cause", "test_basis", "locations", "blockers", "validation_plan", "proposed_test_case"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A candidate disproved during validation, retained so later runs do not repeat it without changed evidence.",
          "properties": {
            "verdict": { "type": "string", "const": "rejected" },
            "fingerprint": { "$ref": "#fingerprint" },
            "module": { "$ref": "#module" },
            "rule": { "$ref": "#rule" },
            "title": { "type": "string", "minLength": 1, "visibleContent": true },
            "claimed_root_cause": { "type": "string", "minLength": 1, "visibleContent": true },
            "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#location" } },
            "reason": { "type": "string", "minLength": 1, "visibleContent": true }
          },
          "required": ["verdict", "fingerprint", "module", "rule", "title", "claimed_root_cause", "locations", "reason"],
          "additionalProperties": false
        }
      ]
    }
  },
  "ledger": {
    "type": "object",
    "properties": {
      "units": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "unit_id": { "type": "string", "pattern": "^(?:functional|api|nonfunctional|testware)/[a-z0-9][a-z0-9._/-]*$" },
            "module": { "$ref": "#module" },
            "scope": { "type": "string", "minLength": 1, "visibleContent": true },
            "starting_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "status": {
              "type": "string",
              "enum": ["planned", "in_progress", "covered", "candidate", "blocked", "deferred", "not_applicable", "out_of_scope"]
            },
            "agent_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
            "reviewed_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
                  "check": { "type": "string", "minLength": 1, "visibleContent": true },
                  "method": { "$ref": "#method" },
                  "result": { "type": "string", "minLength": 1, "visibleContent": true }
                },
                "required": ["agent_id", "check", "method", "result"],
                "additionalProperties": false
              }
            },
            "result_fingerprints": { "type": "array", "uniqueItems": true, "items": { "$ref": "#fingerprint" } },
            "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1, "visibleContent": true } },
            "reason": { "type": ["string", "null"], "minLength": 1 }
          },
          "required": [
            "unit_id", "module", "scope", "starting_paths", "status", "agent_id", "reviewed_paths",
            "checks", "result_fingerprints", "unresolved", "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": ["units"],
    "additionalProperties": false
  },
  "matrix": {
    "type": "object",
    "properties": {
      "test_basis": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "basis_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
            "path": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "enum": ["prd", "user_story", "acceptance_criteria", "readme", "api_contract", "documentation", "code_change", "other"] }
          },
          "required": ["basis_id", "path", "kind"],
          "additionalProperties": false
        }
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "requirement_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
            "basis_id": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "summary": { "type": "string", "minLength": 1, "visibleContent": true },
            "risk_level": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
            "test_conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "condition_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                  "kind": { "type": "string", "enum": ["happy_path", "edge_case", "negative"] },
                  "technique": { "$ref": "#technique" },
                  "summary": { "type": "string", "minLength": 1, "visibleContent": true },
                  "implementation": { "type": "array", "uniqueItems": true, "items": { "$ref": "#location" } },
                  "verdict": { "type": "string", "enum": ["pass", "fail", "not_implemented", "needs_validation", "not_testable"] },
                  "verification_method": { "type": ["string", "null"], "enum": ["source", "local", "staging", null] },
                  "existing_tests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#location" } },
                  "defect_fingerprint": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$" },
                  "note": { "type": ["string", "null"], "minLength": 1 }
                },
                "required": [
                  "condition_id", "kind", "technique", "summary", "implementation", "verdict",
                  "verification_method", "existing_tests", "defect_fingerprint", "note"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["requirement_id", "basis_id", "line", "summary", "risk_level", "test_conditions"],
          "additionalProperties": false
        }
      }
    },
    "required": ["test_basis", "requirements"],
    "additionalProperties": false
  },
  "definitions": {
    "fingerprint": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$" },
    "module": { "type": "string", "enum": ["functional", "api", "nonfunctional", "testware"] },
    "rule": { "type": "string", "pattern": "^(?:FUNC|API|NFR|SDET)-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "method": { "type": "string", "enum": ["source", "local", "staging"] },
    "test_level": { "type": "string", "enum": ["component", "component_integration", "api", "system", "e2e", "acceptance"] },
    "technique": {
      "type": "string",
      "enum": [
        "equivalence_partitioning", "boundary_value_analysis", "decision_table", "state_transition",
        "scenario_testing", "classification_tree", "pairwise", "syntax_testing", "error_guessing",
        "checklist_based", "exploratory", "other"
      ]
    },
    "characteristic": {
      "type": "string",
      "enum": [
        "functional_suitability", "performance_efficiency", "compatibility", "interaction_capability",
        "reliability", "security", "maintainability", "flexibility", "safety"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1, "visibleContent": true }
      },
      "required": ["file", "line", "description"],
      "additionalProperties": false
    },
    "test_case": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "visibleContent": true },
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1, "visibleContent": true } },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "visibleContent": true } },
        "expected_result": { "type": "string", "minLength": 1, "visibleContent": true }
      },
      "required": ["title", "preconditions", "steps", "expected_result"],
      "additionalProperties": false
    }
  }
}
